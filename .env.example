# Vite proxy target for local Knowledge Core API
KC_PROXY_TARGET=http://localhost:8080

# Browser-side defaults (overridable in Settings UI)
VITE_KC_BASE_URL=
VITE_KC_AUTH_MODE=bootstrap
VITE_KC_TOKEN=
VITE_ORG_PACKAGE=org-demo

# MCP server (@itmap/mcp-server) — see server/README.md
# ITMAP_KC_BASE_URL=http://localhost:8080
# ITMAP_MCP_WRITE_PACKAGES=org-ote,org-demo
# ITMAP_MCP_DEFAULT_PACKAGE=org-ote
# ITMAP_MCP_ORG_PACKAGE=org-demo   # legacy single-package alias
# ITMAP_MCP_TRANSPORT=stdio
# ITMAP_MCP_WRITE_MODE=propose
# ITMAP_MCP_AUTH_MODE=service
# ITMAP_KC_AUTH_MODE=bootstrap
# ITMAP_KC_TOKEN=
# ITMAP_MCP_FILE_ROOTS=
# Token login UI (HTTP): set issuer → open http://localhost:3100/token
# ITMAP_MCP_TRANSPORT=http
# ITMAP_MCP_OIDC_ISSUER=https://id.example.com
# ITMAP_MCP_OIDC_CLIENT_ID=knowledge-core
# ITMAP_MCP_OAUTH_ENABLED=false
# ITMAP_MCP_PUBLIC_URL=http://localhost:3100
